# Digest-pinned alongside the tag — see the note in Dockerfile. Keep this
# digest in step with the runtime stage there.
FROM gcr.io/distroless/static-debian13@sha256:f2ea2709ac8db56323cbd7d014277f32cb572d9ea124b0076f7aafe5980678fe

ARG TARGETPLATFORM
ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

LABEL org.opencontainers.image.title="pihole-mcp"
LABEL org.opencontainers.image.description="MCP server for Pi-hole v6"
LABEL org.opencontainers.image.source="https://github.com/hexamatic/pihole-mcp"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.created="${DATE}"
LABEL org.opencontainers.image.revision="${COMMIT}"

# Load-bearing, not decorative: the MCP Registry proves we own the
# io.github.hexamatic/* namespace by reading this annotation off the published
# image and matching it against `name` in server.json. Remove or misspell it and
# `mcp-publisher publish` fails ownership verification. A test in
# internal/config keeps the two in step.
LABEL io.modelcontextprotocol.server.name="io.github.hexamatic/pihole-mcp"

COPY ${TARGETPLATFORM}/pihole-mcp /pihole-mcp

USER nonroot:nonroot

ENTRYPOINT ["/pihole-mcp"]
